 Mat3 RotY(double t) { Mat3 r; r.m[0][0] = std::cos(t); r.m[0][2] = std::sin(t); r.m[2][0] = -std::sin(t); r.m[2][2] = std::cos(t); return r; }
 Mat3 RotZ(double t) { Mat3 r; r.m[0][0] = std::cos(t); r.m[0][1] = -std::sin(t); r.m[1][0] = std::sin(t); r.m[1][1] = std::cos(t); return r; }
+Mat3 RotVector(Vec3 v) {
+    const double t = Len(v);
+    if (t < 1e-10) return Mat3{};
+    const Vec3 a = v * (1.0 / t);
+    const double c = std::cos(t), s = std::sin(t), u = 1 - c;
+    Mat3 r;
+    r.m[0][0] = c + a.x*a.x*u; r.m[0][1] = a.x*a.y*u - a.z*s; r.m[0][2] = a.x*a.z*u + a.y*s;
+    r.m[1][0] = a.y*a.x*u + a.z*s; r.m[1][1] = c + a.y*a.y*u; r.m[1][2] = a.y*a.z*u - a.x*s;
+    r.m[2][0] = a.z*a.x*u - a.y*s; r.m[2][1] = a.z*a.y*u + a.x*s; r.m[2][2] = c + a.z*a.z*u;
+    return r;
+}
 
 // Remote -> world rotation from aim angles: yaw right+, pitch up+, roll right (clockwise as seen by the player)+.
