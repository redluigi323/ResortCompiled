 void HandleSdlEvent(const SDL_Event& ev) {
+    if (ev.type == SDL_EVENT_GAMEPAD_SENSOR_UPDATE && ev.gsensor.which == g_remote.activeGamepad &&
+        ev.gsensor.sensor == SDL_SENSOR_ACCEL && g_remote.sensorGravityValid &&
+        !InputBindings::InputBlocked()) {
+        const float* a = ev.gsensor.data;
+        if (std::isfinite(a[0]) && std::isfinite(a[1]) && std::isfinite(a[2])) {
+            const Vec3 mapped{-a[0] / kGravity, -a[2] / kGravity, a[1] / kGravity};
+            if (Len(mapped) > 0.2 && Len(mapped) < 5.0 &&
+                (!g_remote.peakAccelValid ||
+                 Len(mapped - g_remote.sensorGravity) > Len(g_remote.peakAccel - g_remote.sensorGravity))) {
+                g_remote.peakAccel = mapped;
+                g_remote.peakAccelValid = true;
+            }
+        }
+    }
     if (ev.type == SDL_EVENT_MOUSE_WHEEL && !DualSenseGamepad() && !InputBindings::InputBlocked()) {
         const float y = ev.wheel.direction == SDL_MOUSEWHEEL_FLIPPED ? -ev.wheel.y : ev.wheel.y;
         g_remote.wheelSteps += y;
